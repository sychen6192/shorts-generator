{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shortsloop verdict v1 (FROZEN — docs/plan.md §2.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "failure_classes",
    "error",
    "clip",
    "prompt",
    "l1",
    "l2",
    "thresholds",
    "layers_run",
    "timing",
    "versions"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1"
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "PROCEED"
      ]
    },
    "failure_classes": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "enum": [
          "broken",
          "black",
          "static",
          "deformed",
          "flicker",
          "off_prompt",
          "blurry"
        ]
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "scope",
        "stage",
        "message"
      ],
      "properties": {
        "scope": {
          "enum": [
            "clip",
            "infra"
          ]
        },
        "stage": {
          "enum": [
            "probe",
            "l1",
            "l2"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "container"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "container": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "duration_s",
            "width",
            "height",
            "fps",
            "nb_frames",
            "vcodec"
          ],
          "properties": {
            "duration_s": {
              "type": [
                "number",
                "null"
              ]
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "fps": {
              "type": [
                "number",
                "null"
              ]
            },
            "nb_frames": {
              "type": [
                "integer",
                "null"
              ]
            },
            "vcodec": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "sha256"
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "l1": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "analysis",
        "metrics",
        "checks",
        "pass"
      ],
      "properties": {
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "flow_downscale",
            "frames_analyzed"
          ],
          "properties": {
            "width": {
              "const": 480
            },
            "height": {
              "const": 832
            },
            "flow_downscale": {
              "const": 2
            },
            "frames_analyzed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "flow_mag_median",
            "flow_mag_p90",
            "ssim_min",
            "ssim_p05",
            "ssim_mean",
            "flicker_dips",
            "freeze_longest_run_s",
            "laplacian_p10",
            "laplacian_median",
            "luma_mean",
            "black_frame_frac",
            "clipped_frac"
          ],
          "properties": {
            "flow_mag_median": {
              "type": "number"
            },
            "flow_mag_p90": {
              "type": "number"
            },
            "ssim_min": {
              "type": "number"
            },
            "ssim_p05": {
              "type": "number"
            },
            "ssim_mean": {
              "type": "number"
            },
            "flicker_dips": {
              "type": "integer",
              "minimum": 0
            },
            "freeze_longest_run_s": {
              "type": "number"
            },
            "laplacian_p10": {
              "type": "number"
            },
            "laplacian_median": {
              "type": "number"
            },
            "luma_mean": {
              "type": "number"
            },
            "black_frame_frac": {
              "type": "number"
            },
            "clipped_frac": {
              "type": "number"
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "metric",
              "op",
              "threshold",
              "value",
              "pass",
              "reason"
            ],
            "properties": {
              "name": {
                "enum": [
                  "spec",
                  "motion",
                  "freeze",
                  "flicker",
                  "ssim_floor",
                  "sharpness",
                  "black",
                  "exposure"
                ]
              },
              "metric": {
                "type": "string"
              },
              "op": {
                "enum": [
                  ">=",
                  "<=",
                  "match"
                ]
              },
              "threshold": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "pass": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "pass": {
          "type": "boolean"
        }
      }
    },
    "l2": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "model",
        "model_digest",
        "temperature",
        "seed",
        "frames",
        "dimensions",
        "pass",
        "raw_response_sha256"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "model_digest": {
          "type": "string"
        },
        "temperature": {
          "type": "number"
        },
        "seed": {
          "type": "integer"
        },
        "frames": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "t"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "t": {
                "type": "number"
              }
            }
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt_adherence",
            "subject_consistency",
            "anatomy_artifacts",
            "temporal_coherence",
            "imaging_quality"
          ],
          "properties": {
            "prompt_adherence": {
              "$ref": "#/$defs/dimension"
            },
            "subject_consistency": {
              "$ref": "#/$defs/dimension"
            },
            "anatomy_artifacts": {
              "$ref": "#/$defs/dimension"
            },
            "temporal_coherence": {
              "$ref": "#/$defs/dimension"
            },
            "imaging_quality": {
              "$ref": "#/$defs/dimension"
            }
          }
        },
        "pass": {
          "type": "boolean"
        },
        "raw_response_sha256": {
          "type": "string"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "calibrated",
        "file_sha256"
      ],
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "calibrated": {
          "type": "boolean"
        },
        "file_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "layers_run": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "enum": [
          "l1",
          "l2"
        ]
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "l1_s",
        "l2_s"
      ],
      "properties": {
        "l1_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "l2_s": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checker",
        "python",
        "opencv",
        "numpy",
        "ffprobe"
      ],
      "properties": {
        "checker": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "opencv": {
          "type": "string"
        },
        "numpy": {
          "type": "string"
        },
        "ffprobe": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "floor",
        "na",
        "pass",
        "reason"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "floor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "na": {
          "type": "boolean"
        },
        "pass": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
